# Copy to .env and adjust. Loaded by the Makefile (`-include .env`) for local dev / atlas / compose.
# One shared Postgres instance for both go-oikumenea (`oikumenea` schema) and OpenFaithMap
# (`openfaithmap` schema) — see docker-compose.yml.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable

# M2 registration module — produced once by scripts/bootstrap-registration-org (prints both IDs).
# The single shared root unit congregations are registered beneath, and the role granted to a
# submitter on their own new unit when their registration is approved.
REGISTRATION_ROOT_UNIT_ID=
REGISTRATION_CONGREGATION_ADMIN_ROLE_ID=

# go-oikumenea (M1, D-CoreDependency) — reached over the compose network at https://oikumenea-app:8443
# from inside openfaithmap-api; from the host (e.g. for scripts/manual bootstrap) it has no published
# port (D-HeadlessTopology), so use `docker compose exec`/a throwaway network container instead.

# hermenea (M2.2, D-BulkImport) — two trust directions, two secrets, both read by go-oikumenea's
# oikumenea-app and by hermenea itself (docker-compose.yml). INSECURE defaults below match
# go-oikumenea's own docker-compose.yml literally so both repos interoperate out of the box; replace
# for any real deployment.
HERMENEA_OIKUMENEA_TOKEN=dev-hermenea-importer-token-change-me
OIKUMENEA_HERMENEA_TOKEN=dev-oikumenea-trigger-token-change-me

# GCP service-account key for OpenFaithMap's service principal (M1) — never committed (var/*.json is
# gitignored). See internal/coreintegration. Used both by host-side scripts
# (scripts/bootstrap-service-principal) and, as of M4, mounted into openfaithmap-api's own
# container (docker-compose.yml) — the first production caller of coreintegration.NewServiceClient,
# for discovery's cache-miss fallback.
GOOGLE_APPLICATION_CREDENTIALS=var/service-account.json

# M10.2 identity middleware (D-DirectTokenVerification) — not yet load-bearing (the middleware is
# built and Bind-wired but not attached to the live server until M10.6), but GOOGLE_OAUTH_CLIENT_ID
# is a hard requireEnv and boot fails without it. Same Google OAuth client id
# web/apps/admin/.env.example's AUTH_GOOGLE_ID already uses.
GOOGLE_OAUTH_CLIENT_ID=459963198200-qlhu1um4h9bik68608c73o671rcqv4je.apps.googleusercontent.com
# DEV_ISSUER_HMAC_KEY — local/dev only, symmetric HS256 signing key for a synthetic test issuer.
# Leave commented out. GuardSymmetricIssuers refuses this outside local/dev regardless, but the
# convention is to never carry a value here at all, so a copied override can't leak a real secret.
# DEV_ISSUER_HMAC_KEY=
# BOOTSTRAP_ADMIN_* — the first instance admin, seeded at boot from these values (never a migration
# — D-SeedBootstrap). Leave unset for now: identity_persons/authz_instance_admins have no live
# consumer until M10.6. ISSUER/SUBJECT are the Google ID token's (iss, sub) for the real admin
# account this deployment should seed.
BOOTSTRAP_ADMIN_ISSUER=
BOOTSTRAP_ADMIN_SUBJECT=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_DISPLAY_NAME=

# congregationimport (D-CongregationImport, docs/modules/congregationimport.md) — optional, unset by
# default. Set AT MOST ONE of the two below (uaedr.New refuses both/neither):
#
# UAEDR_UO_FILE_PATH — path to a locally-downloaded copy of Ukraine's ЄДР legal-entities export
# (uo.zip or an already-extracted uo.xml), as it appears INSIDE the openfaithmap-api container —
# mount it in via an extra docker-compose.yml volumes entry, same shape as
# GOOGLE_APPLICATION_CREDENTIALS above.
#
# UAEDR_SOURCE_URL — stream the export directly over HTTP instead, with no local file ever landing
# on disk (bounded RAM regardless of source size — for a cheap, memory-constrained VM deployment
# with no cron job or object storage available). The exact current resource URL is an
# operator-supplied value, confirmed against data.gov.ua at deploy time — not hardcoded here.
#
# Real source either way: data.gov.ua, dataset 03cc1239-3988-4451-aa0d-aadb77448714, resource
# "uo.zip" (weekly, free, ~300MB compressed). Leave both unset to run without the ЄДР connector
# registered at all.
UAEDR_UO_FILE_PATH=
UAEDR_SOURCE_URL=

# ar-rnc (Argentina's Registro Nacional de Cultos) — optional, unset by default. Set AT MOST ONE of
# the two below (arrnc.New refuses both/neither). Unlike ua-edr, this source is small (3.6MB) — no
# streaming mode exists or is needed, so ARRNC_SOURCE_URL is just a plain HTTP GET, fetched once per
# run, not a memory-bounding concern the way UAEDR_SOURCE_URL is.
#
# ARRNC_FILE_PATH — path to a locally-downloaded copy of the RNC export CSV, as it appears INSIDE
# the openfaithmap-api container — mount it in the same way as UAEDR_UO_FILE_PATH above.
#
# ARRNC_SOURCE_URL — fetch the export directly over HTTP instead. Real, current resource URL
# (verified live 2026-08-14 — the CKAN-listed one is dead, see arrnc's own package doc comment):
# https://cancilleria.gob.ar/userfiles/datos/registro-culto-export.csv (~3.6MB, no fixed update
# schedule declared by the source). Leave both unset to run without the ar-rnc connector registered
# at all.
ARRNC_FILE_PATH=
ARRNC_SOURCE_URL=

# osm (OpenStreetMap, Overpass API) — optional, unset by default. Only OSM_COUNTRY_CODES gates
# registration (osm.New); OSM_OVERPASS_BASE_URL has a real code default and only needs setting to
# override it.
#
# OSM_COUNTRY_CODES — comma-separated ISO 3166-1 alpha-2 codes, e.g. "UY,PY,CO,CL". Default scope
# recommendation: Uruguay/Paraguay/Colombia/Chile — the D-Scope rollout countries with no confirmed
# dedicated government registry (unlike ua-edr/ar-rnc, which already cover Ukraine/Argentina, or
# Brazil's CNPJ, confirmed real but blocked — see docs/modules/congregationimport.md). Every code
# must be present in osm's own countryNames map (adapters/connectors/osm/connector.go) or New
# refuses to construct the connector.
#
# OSM_OVERPASS_BASE_URL — defaults to https://overpass.kumi.systems/api/interpreter if unset. Chosen
# over the main OSM-Foundation-run mirror (overpass-api.de) because that one's own robots.txt
# disallows /api/ — the exact path the query endpoint lives at (checked live 2026-08-14). This
# mirror has no robots.txt at all (404, confirmed live) and its operator (Private.coffee / Kumi
# Systems) publishes a policy welcoming reasonable use, asking only that large-scale projects notify
# them first — see osm's own Citation() for the full record. Leave OSM_COUNTRY_CODES unset to run
# without the osm connector registered at all.
OSM_COUNTRY_CODES=
OSM_OVERPASS_BASE_URL=

# wikidata-catholic jurisdiction sync (D-CatholicJurisdictionSync,
# docs/architecture/decisions.md) — optional, unset by default. Automated, unattended creation of
# Catholic dioceses/eparchies as real go-oikumenea jurisdiction-tier Units (never a congregation) from
# Wikidata's SPARQL API, cross-referenced to Catholic-Hierarchy.org (wdt:P1866) so the scope is
# cleanly "actually Catholic," not the generic wdt:P708 "diocese" property Orthodox/Anglican bodies
# also carry. Triggered via POST /congregation-import/v1/jurisdiction-sync/runs
# {"sourceCode":"wikidata-catholic"} — same operator-triggered-HTTP-endpoint pattern every connector
# run already uses, suitable for a systemd timer (M9's own precedent).
#
# CATHOLIC_JURISDICTION_ANCHOR_UNIT_ID — a real go-oikumenea Unit RID an operator must create ONCE,
# out-of-band, through the admin "Create unit" modal, before running a real sync — every top-level
# (no-parent) node's createChildOrg call targets this unit as parent
# (application.Config.CatholicJurisdictionAnchorUnitID). Also gates whether the wikidata-catholic
# source registers at all (cmd/openfaithmap-api/main.go) — leave unset to run without it.
#
# CATHOLIC_JURISDICTION_COUNTRY_QIDS — comma-separated Wikidata country QIDs, e.g. "Q212" for Ukraine
# (the owner's own first live-verification target, since ua-edr's already-large candidate set has
# diocese names embedded in scraped legal names with no alias to match against yet). Empty means
# every country worldwide (6,655 Catholic dioceses/eparchies, live-verified 2026-08-15).
#
# CATHOLIC_JURISDICTION_WIKIDATA_BASE_URL — defaults to https://query.wikidata.org/sparql if unset.
#
# Status (2026-08-16): live-verified end to end. CreateChildOrg's go-oikumenea PEP gate is fixed
# upstream (go-oikumenea#39, image 0.0.6) and scripts/bootstrap-service-principal grants
# religionorg.manage ORG-scoped (-catholic-jurisdiction-org-id — an instance-wide grant alone does
# NOT satisfy go-oikumenea's tenant_units RLS check for a machine subject, found live). The deeper
# RLS gap on the follow-on tenant_unit_edges insert (go-oikumenea#41 — a RETURNING-needs-read-reach
# gap, not a policy bug) is fixed upstream too, image 0.0.7 (bumped in docker-compose.yml).
# Re-verifying against it found religion.read ALSO needs to be org-scoped (not just the instance-wide
# grant this script already had for an unrelated reason) — bootstrap-service-principal now grants
# both org-scoped. With both in place, a real sync against a live stack created all 38 Ukrainian
# dioceses with real, closure-confirmed tenant_unit_edges, idempotent on a second run. See
# D-CatholicJurisdictionSync for the full trace.
CATHOLIC_JURISDICTION_ANCHOR_UNIT_ID=
CATHOLIC_JURISDICTION_COUNTRY_QIDS=
CATHOLIC_JURISDICTION_WIKIDATA_BASE_URL=

# congregationimport geocoding (application.Geocoder, real implementation added 2026-08-14) —
# optional, defaults to "nominatim" if unset. Selects which REGISTERED provider serves
# suggestCoordinates (cmd/openfaithmap-api/main.go's geocoders slice) — Nominatim (OpenStreetMap,
# free, keyless) is the only one registered today; adding a second (LocationIQ, Google) is a new
# adapter package + one more line in that slice, and switching to it is just this env var, no code
# change. Always advisory — never applied without the operator explicitly saving via editCandidate.
CONGREGATIONIMPORT_GEOCODER=nominatim

# openfaithmap-admin (M2.1, D-AdminSurface) — Auth.js session secret + Google OAuth client secret,
# never committed. Read by docker-compose.yml's openfaithmap-admin service (see
# web/apps/admin/.env.example for the full set of variables that service reads; AUTH_GOOGLE_ID is
# non-secret and hardcoded there). openfaithmap-web holds no session and reads none of these vars —
# it never runs Auth.js (D-AdminSurface).
# openssl rand -base64 32
OPENFAITHMAP_ADMIN_AUTH_SECRET=
# The OAuth client's secret, from Google Cloud Console (matches AUTH_GOOGLE_ID's client, whose
# redirect URI must include http://localhost:3004/api/auth/callback/google).
AUTH_GOOGLE_SECRET=

# oikumenea-console (M1.2, D-InstanceAdminConsole) — go-oikumenea's own published admin console.
# Its own Auth.js session secret, distinct from openfaithmap-admin's OPENFAITHMAP_ADMIN_AUTH_SECRET
# above (two independent sessions). Reuses AUTH_GOOGLE_ID/AUTH_GOOGLE_SECRET above (same Google
# OAuth client, multiple callback origins) — no separate Google secret needed. Read by
# docker-compose.yml's oikumenea-console service.
# openssl rand -base64 32
OIKUMENEA_CONSOLE_AUTH_SECRET=
