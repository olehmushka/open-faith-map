# Copy to .env and adjust. Loaded by the Makefile (`-include .env`) for local dev / atlas / compose.
# One shared Postgres instance for both go-oikumenea (`oikumenea` schema) and OpenFaithMap
# (`openfaithmap` schema) — see docker-compose.yml.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable

# M2 registration module — produced once by scripts/bootstrap-registration-org (prints both IDs).
# The single shared root unit congregations are registered beneath, and the role granted to a
# submitter on their own new unit when their registration is approved.
REGISTRATION_ROOT_UNIT_ID=
REGISTRATION_CONGREGATION_ADMIN_ROLE_ID=

# go-oikumenea (M1, D-CoreDependency) — reached over the compose network at https://oikumenea-app:8443
# from inside openfaithmap-api; from the host (e.g. for scripts/manual bootstrap) it has no published
# port (D-HeadlessTopology), so use `docker compose exec`/a throwaway network container instead.

# GCP service-account key for OpenFaithMap's service principal (M1) — never committed (var/*.json is
# gitignored). See internal/coreintegration.
GOOGLE_APPLICATION_CREDENTIALS=var/service-account.json

# openfaithmap-web (M1) — Auth.js session secret + Google OAuth client secret, never committed.
# Read by docker-compose.yml's openfaithmap-web service (see web/.env.example for the full set of
# variables that service reads; AUTH_GOOGLE_ID is non-secret and hardcoded there).
# openssl rand -base64 32
AUTH_SECRET=
# The OAuth client's secret, from Google Cloud Console (matches AUTH_GOOGLE_ID's client, whose
# redirect URI must include http://localhost:3002/api/auth/callback/google).
AUTH_GOOGLE_SECRET=

# oikumenea-console (M1.2, D-InstanceAdminConsole) — go-oikumenea's own published admin console.
# Its own Auth.js session secret, distinct from openfaithmap-web's AUTH_SECRET above (two
# independent sessions). Reuses AUTH_GOOGLE_ID/AUTH_GOOGLE_SECRET above (same Google OAuth client,
# two callback origins) — no separate Google secret needed. Read by docker-compose.yml's
# oikumenea-console service.
# openssl rand -base64 32
OIKUMENEA_CONSOLE_AUTH_SECRET=
