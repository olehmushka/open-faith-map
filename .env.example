# Copy to .env and adjust. Loaded by the Makefile (`-include .env`) for local dev / atlas / compose.
# One shared Postgres instance for both go-oikumenea (`oikumenea` schema) and OpenFaithMap
# (`openfaithmap` schema) — see docker-compose.yml.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable

# M2 registration module — produced once by scripts/bootstrap-registration-org (prints both IDs).
# The single shared root unit congregations are registered beneath, and the role granted to a
# submitter on their own new unit when their registration is approved.
REGISTRATION_ROOT_UNIT_ID=
REGISTRATION_CONGREGATION_ADMIN_ROLE_ID=

# go-oikumenea (M1, D-CoreDependency) — reached over the compose network at https://oikumenea-app:8443
# from inside openfaithmap-api; from the host (e.g. for scripts/manual bootstrap) it has no published
# port (D-HeadlessTopology), so use `docker compose exec`/a throwaway network container instead.

# hermenea (M2.2, D-BulkImport) — two trust directions, two secrets, both read by go-oikumenea's
# oikumenea-app and by hermenea itself (docker-compose.yml). INSECURE defaults below match
# go-oikumenea's own docker-compose.yml literally so both repos interoperate out of the box; replace
# for any real deployment.
HERMENEA_OIKUMENEA_TOKEN=dev-hermenea-importer-token-change-me
OIKUMENEA_HERMENEA_TOKEN=dev-oikumenea-trigger-token-change-me

# GCP service-account key for OpenFaithMap's service principal (M1) — never committed (var/*.json is
# gitignored). See internal/coreintegration. Used both by host-side scripts
# (scripts/bootstrap-service-principal) and, as of M4, mounted into openfaithmap-api's own
# container (docker-compose.yml) — the first production caller of coreintegration.NewServiceClient,
# for discovery's cache-miss fallback.
GOOGLE_APPLICATION_CREDENTIALS=var/service-account.json

# congregationimport (D-CongregationImport, docs/modules/congregationimport.md) — optional, unset by
# default. Set AT MOST ONE of the two below (uaedr.New refuses both/neither):
#
# UAEDR_UO_FILE_PATH — path to a locally-downloaded copy of Ukraine's ЄДР legal-entities export
# (uo.zip or an already-extracted uo.xml), as it appears INSIDE the openfaithmap-api container —
# mount it in via an extra docker-compose.yml volumes entry, same shape as
# GOOGLE_APPLICATION_CREDENTIALS above.
#
# UAEDR_SOURCE_URL — stream the export directly over HTTP instead, with no local file ever landing
# on disk (bounded RAM regardless of source size — for a cheap, memory-constrained VM deployment
# with no cron job or object storage available). The exact current resource URL is an
# operator-supplied value, confirmed against data.gov.ua at deploy time — not hardcoded here.
#
# Real source either way: data.gov.ua, dataset 03cc1239-3988-4451-aa0d-aadb77448714, resource
# "uo.zip" (weekly, free, ~300MB compressed). Leave both unset to run without the ЄДР connector
# registered at all.
UAEDR_UO_FILE_PATH=
UAEDR_SOURCE_URL=

# ar-rnc (Argentina's Registro Nacional de Cultos) — optional, unset by default. Set AT MOST ONE of
# the two below (arrnc.New refuses both/neither). Unlike ua-edr, this source is small (3.6MB) — no
# streaming mode exists or is needed, so ARRNC_SOURCE_URL is just a plain HTTP GET, fetched once per
# run, not a memory-bounding concern the way UAEDR_SOURCE_URL is.
#
# ARRNC_FILE_PATH — path to a locally-downloaded copy of the RNC export CSV, as it appears INSIDE
# the openfaithmap-api container — mount it in the same way as UAEDR_UO_FILE_PATH above.
#
# ARRNC_SOURCE_URL — fetch the export directly over HTTP instead. Real, current resource URL
# (verified live 2026-08-14 — the CKAN-listed one is dead, see arrnc's own package doc comment):
# https://cancilleria.gob.ar/userfiles/datos/registro-culto-export.csv (~3.6MB, no fixed update
# schedule declared by the source). Leave both unset to run without the ar-rnc connector registered
# at all.
ARRNC_FILE_PATH=
ARRNC_SOURCE_URL=

# openfaithmap-admin (M2.1, D-AdminSurface) — Auth.js session secret + Google OAuth client secret,
# never committed. Read by docker-compose.yml's openfaithmap-admin service (see
# web/apps/admin/.env.example for the full set of variables that service reads; AUTH_GOOGLE_ID is
# non-secret and hardcoded there). openfaithmap-web holds no session and reads none of these vars —
# it never runs Auth.js (D-AdminSurface).
# openssl rand -base64 32
OPENFAITHMAP_ADMIN_AUTH_SECRET=
# The OAuth client's secret, from Google Cloud Console (matches AUTH_GOOGLE_ID's client, whose
# redirect URI must include http://localhost:3004/api/auth/callback/google).
AUTH_GOOGLE_SECRET=

# oikumenea-console (M1.2, D-InstanceAdminConsole) — go-oikumenea's own published admin console.
# Its own Auth.js session secret, distinct from openfaithmap-admin's OPENFAITHMAP_ADMIN_AUTH_SECRET
# above (two independent sessions). Reuses AUTH_GOOGLE_ID/AUTH_GOOGLE_SECRET above (same Google
# OAuth client, multiple callback origins) — no separate Google secret needed. Read by
# docker-compose.yml's oikumenea-console service.
# openssl rand -base64 32
OIKUMENEA_CONSOLE_AUTH_SECRET=
