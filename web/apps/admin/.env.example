# Documents the shape openfaithmap-admin reads its config from — non-secret, committed. Next.js
# reads its OWN .env/.env.local in this directory, NOT the repo-root .env (that one is
# Makefile/compose only). Real secrets for a host-run instance can go in web/apps/admin/.env or
# web/apps/admin/.env.local — both are gitignored — but never in this file, which is committed.
#
# OPENFAITHMAP_API_BASE_URL is unreachable from a host-run `next dev` — openfaithmap-api (M1,
# D-HeadlessTopology) publishes no host port for its app listener. Testing the real login flow
# requires `docker compose up`, which injects these same variables (AUTH_SECRET as
# OPENFAITHMAP_ADMIN_AUTH_SECRET / AUTH_GOOGLE_SECRET from the repo-root .env) into the
# openfaithmap-admin compose service instead — see docker-compose.yml.

OPENFAITHMAP_API_BASE_URL="https://openfaithmap-api:3000"
# openfaithmap-api serves a self-signed cert in local dev. DEV ONLY — never set this in production.
NODE_TLS_REJECT_UNAUTHORIZED="0"

AUTH_SECRET="dev-only-change-me"
AUTH_URL="http://localhost:3004"
AUTH_TRUST_HOST="true"

# Non-secret: matches the audience deploy/oikumenea-install.yml's Google issuer entry pins.
AUTH_GOOGLE_ID="459963198200-qlhu1um4h9bik68608c73o671rcqv4je.apps.googleusercontent.com"
# AUTH_GOOGLE_SECRET=   # real value goes in web/apps/admin/.env.local, never here

# M4.1 — congregation-import's jurisdiction picker needs the shared root unit id to start browsing
# from. Non-secret: internal/platform/seed.RootUnitID, the fixed structural RID
# migrations/0022_core_seed.sql seeds (M10.6/M10.7: no longer go-oikumenea's own root — this
# repo's own core owns unit hierarchy now).
REGISTRATION_ROOT_UNIT_ID="01989e26-ce01-8101-8301-0196a3b0bdca"
