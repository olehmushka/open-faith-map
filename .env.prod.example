# M14.18. Copy to .env on the production VM (chmod 600, never committed — D-ProductionDeployment's
# secrets handling), fill in real values, then:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# 🔶 None of this does anything until U14 resolves: a real apex domain, registered and with its DNS
# delegated to a provider Caddy has a module for. See deploy/README.md.

# The registered apex domain, no scheme, no trailing slash — e.g. openfaithmap.org.
# admin.<this> serves openfaithmap-admin; <this> and *.<this> serve openfaithmap-web
# (deploy/caddy/Caddyfile).
APEX_DOMAIN=

# Address Let's Encrypt sends expiry/problem notices to.
ACME_EMAIL=

# Cloudflare API token (Zone:DNS:Edit scope on APEX_DOMAIN's zone) — the example DNS-01 provider
# deploy/caddy/Caddyfile is wired to. Swap for a different provider by following
# deploy/README.md's "Using a different DNS provider" section instead of filling this in.
CLOUDFLARE_API_TOKEN=

# Everything else this override needs (CONTENT_REVALIDATION_SECRET, OPENFAITHMAP_ADMIN_AUTH_SECRET,
# AUTH_GOOGLE_SECRET, REGISTRATION_ROOT_UNIT_ID, BOOTSTRAP_ADMIN_*, ...) is the same set
# docker-compose.yml already reads — see that file's own inline comments for each one.
